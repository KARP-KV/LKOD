  "název": {
    "cs": "Přírodní pozoruhodnosti v Karlovarském kraji"
  },
  "popis": {
    "cs": "Datová sada obsahuje přehled přírodních pozoruhodností na území Karlovarského kraje včetně jejich prostorové lokalizace. Součástí datové sady jsou také informace o typu přírodní pozoruhodnosti, její specifikaci a správci, včetně názvu organizace, identifikačního čísla, právní formy, sídla, kódu adresy, identifikátoru datové schránky, kontaktního e-mailu a telefonního spojení. Dále datová sada obsahuje odkaz na webovou stránku s podrobnějšími informacemi o dané přírodní pozoruhodnosti.&nbsp;Souřadnice jsou vedeny v souřadnicovém systému WGS 1984.Poskytovatelem dat je Krajské inovační centrum Karlovarského kraje, příspěvková organizace.&nbsp;"
  },
  "klíčové_slovo": {
    "cs": [
      "Příroda",
      "pozoruhodnost",
      "přírodní",
      "Karlovarský kraj"
    ]
  },
