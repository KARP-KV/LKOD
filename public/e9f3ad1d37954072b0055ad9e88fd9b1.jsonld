  "název": {
    "cs": "Rybářské revíry ČRS spravované v Karlovarském kraji"
  },
  "popis": {
    "cs": "Datová sada obsahuje přehled rybářských revírů Českého rybářského svazu spravovaných místními organizacemi v Karlovarském kraji. U jednotlivých revírů jsou uvedeny identifikační údaje (název a číslo revíru), správce revíru, územní příslušnost, rozloha, popis revíru a prostorová lokalizace prostřednictvím souřadnic a vektorové geometrie. Prostorová data jsou vedena v souřadnicovém systému WGS 1984.&nbsp;Zdrojem dat je Český rybářský svaz (evidence rybářských revírů).&nbsp;"
  },
  "klíčové_slovo": {
    "cs": [
      "rybářský",
      "revír",
      "Karlovarský kraj",
      "rybolov"
    ]
