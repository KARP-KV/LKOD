  "název": {
    "cs": "Muzea a galerie v Karlovarském kraji"
  },
  "popis": {
    "cs": "Datová sada obsahuje přehled muzeí a galerií v Karlovarském kraji včetně jejich prostorové lokalizace. Součástí datové sady jsou také informace o provozovateli (název, identifikační číslo, právní forma, sídlo, kód adresy a ID datové schránky), webových stránkách, kontaktním telefonu a e-mailu, přístupnosti objektu a vstupném. Datová sada dále obsahuje územní identifikaci objektů a jejich souřadnice v souřadnicovém systému WGS 1984.Zdrojem dat je Krajské inovační centrum Karlovarského kraje, příspěvková organizace.&nbsp;"
  },
  "klíčové_slovo": {
    "cs": [
      "muzeum",
      "galerie",
      "Karlovarský kraj"
    ]
  },
