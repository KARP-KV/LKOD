  "název": {
    "cs": "Památky UNESCO v Karlovarském kraji"
  },
  "popis": {
    "cs": "Datová sada obsahuje seznam památek UNESCO v Karlovarském kraji včetně jejich prostorové lokalizace. Součástí datové sady jsou také informace o typu památky a o správci či informační instituci dané památky, zejména název, identifikační číslo, sídlo, právní forma, kód adresy, identifikátor datové schránky, kontaktní e-mail, telefonní číslo a webové stránky. Data jsou poskytována v souřadnicovém systému WGS 1984.Zdrojem dat je Krajské inovační centrum Karlovarského kraje, p.o.&nbsp;"
  },
  "klíčové_slovo": {
    "cs": [
      "UNESCO",
      "památka",
      "Karlovarský kraj"
    ]
  },
